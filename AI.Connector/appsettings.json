{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Cấu hình kết nối tới LLM (LM Studio)
  "OpenAI": {
    "Endpoint": "http://localhost:1234/v1", // Địa chỉ mặc định của LM Studio khi chạy server
    "Model": "openai/gpt-oss-20b", // Tên model (bạn có thể thay đổi tùy theo model đang load trong LM Studio)
    "ApiKey": "lm-studio" // Key bất kỳ (LM Studio local thường không check key)
  },
  
  // Cấu hình MCP Server
  "McpServer": {
    "ExecutablePath": "D:\\OutSource\\MCP-Server\\MCP-Server\\bin\\Debug\\net8.0\\MCP-Server.exe"
  },

  // Cấu hình Serilog để ghi log đẹp hơn
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" } // Ghi log ra màn hình Console
    ]
  }
}
